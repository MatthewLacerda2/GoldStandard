# Copy to .env and adjust. Never commit the real .env.

# Database — accepts postgres:// / postgresql:// (normalized to postgresql+asyncpg://).
# A host's libpq query parameters are translated: `sslmode` → `ssl`, `connect_timeout`
# → `timeout`, `application_name` → a server setting, `channel_binding=prefer|disable`
# dropped (asyncpg cannot bind the channel). Any other key asyncpg does not take,
# `channel_binding=require` included, stops startup with an error that names it.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app

# Auth — generate a strong random secret in real deployments.
JWT_SECRET=change-me-in-production-min-32-bytes
JWT_ISSUER=goldstandard
JWT_AUDIENCE=goldstandard-app
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Seeded on startup if the database has no user yet.
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-me

# CORS (comma-separated origins).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Global rate limit applied to every request (empty disables it).
RATE_LIMIT_DEFAULT=10/second

# Frontend dev server pointing at a standalone backend. Vite reads this at
# build time from frontend/ — put it in frontend/.env, not this root .env.
# Unset, the app uses the relative /api/v1 that works behind the proxy.
# VITE_API_URL=http://localhost:8000/api/v1
